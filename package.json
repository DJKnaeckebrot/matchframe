{
  "name": "matchframe",
  "version": "0.1.0-alpha.1",
  "private": true,
  "license": "MPL-2.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "bun test",
    "build:exe": "bun run scripts/release-windows.ts --exe",
    "build:portable": "bun run scripts/release-windows.ts --portable",
    "build:installer": "bun run scripts/release-windows.ts --installer",
    "release:windows": "bun run scripts/release-windows.ts",
    "fixture:gsi": "bun run scripts/fixture-gsi.ts",
    "portraits:import": "bun run scripts/import-portraits.ts",
    "capture:gsi": "bun run scripts/capture-gsi.ts",
    "capture:readme": "bun run scripts/capture-readme-screenshots.ts"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.18",
    "typescript": "~6"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
